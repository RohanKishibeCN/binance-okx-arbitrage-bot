# ============================================
# 套利机器人环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================

# 交易模式
DRY_RUN=True

# ============================================
# Binance API 配置
# ============================================
BINANCE_API=your_binance_api_key
BINANCE_SECRET=your_binance_secret

# ============================================
# OKX API 配置
# ============================================
OKX_API=your_okx_api_key
OKX_SECRET=your_okx_secret
OKX_PASSPHRASE=your_okx_passphrase

# ============================================
# Notion 配置 (可选)
# ============================================
NOTION_TOKEN=your_notion_integration_token
NOTION_DB_ID=your_notion_database_id
ENABLE_NOTION_LOGGING=true

# ============================================
# Nanobot QQ 推送配置 (可选)
# ============================================
NANOBOT_URL=http://your-nanobot-server:port
ENABLE_QQ_NOTIFICATION=true

# ============================================
# 交易配置
# ============================================
TRADING_FEE_RATE=0.001
TRADING_SLIPPAGE_BUFFER=0.002
MIN_PROFIT=0.006
TRADE_AMOUNT_USDT=50
MIN_ORDERBOOK_DEPTH=1000
CHECK_INTERVAL=1.0

# ============================================
# 风控配置
# ============================================
RISK_MAX_DAILY_LOSS=100
RISK_MAX_POSITION_SIZE=500
RISK_MAX_TRADES_PER_DAY=20
RISK_COOLDOWN_MINUTES=5
RISK_MAX_CONSECUTIVE_LOSSES=3