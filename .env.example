# ============================================
# 套利机器人环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================

# ============================================
# 交易模式 (重要！)
# True = 模拟模式，只检测机会不交易
# False = 真实交易模式
# ============================================
DRY_RUN=True

# ============================================
# Binance API 配置
# 在 https://www.binance.com/en/my/settings/api-management 创建
# 需要启用现货交易权限
# ============================================
BINANCE_API=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# ============================================
# OKX API 配置
# 在 https://www.okx.com/account/my-api 创建
# 需要启用现货交易权限
# ============================================
OKX_API=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# ============================================
# Notion 配置 (可选，用于记录交易)
# 在 https://www.notion.so/my-integrations 创建集成
# ============================================
NOTION_TOKEN=your_notion_integration_token
NOTION_DB_ID=your_notion_database_id
ENABLE_NOTION_LOGGING=true

# ============================================
# Nanobot QQ 推送配置 (可选)
# Nanobot 是一个 QQ 机器人框架
# ============================================
NANOBOT_URL=http://your-nanobot-server:port
ENABLE_QQ_NOTIFICATION=true

# ============================================
# 交易参数配置
# ============================================

# 最小利润率 (0.004 = 0.4%)
# 建议值: 0.003 - 0.008
# 太小容易亏损，太大机会太少
MIN_PROFIT=0.004

# 每笔交易金额 (USDT)
TRADE_AMOUNT_USDT=50

# 手续费率 (0.001 = 0.1%，Binance 和 OKX 默认)
TRADING_FEE_RATE=0.001

# 滑点缓冲 (0.0015 = 0.15%)
# 用于应对价格波动
TRADING_SLIPPAGE_BUFFER=0.0015

# 检查间隔 (秒)
# 越小检测越频繁，但 API 调用越多
CHECK_INTERVAL=0.5

# 最小订单簿深度
MIN_ORDERBOOK_DEPTH=500

# ============================================
# 风控配置
# ============================================

# 每日最大亏损 (USDT)
RISK_MAX_DAILY_LOSS=200

# 单笔最大持仓 (USDT)
RISK_MAX_POSITION_SIZE=500

# 每日最大交易次数
RISK_MAX_TRADES_PER_DAY=50

# 连续亏损后冷却时间 (分钟)
RISK_COOLDOWN_MINUTES=3

# 最大连续亏损次数
RISK_MAX_CONSECUTIVE_LOSSES=5

# ============================================
# 高级配置 (一般不需要修改)
# ============================================

# 交易所沙盒模式
EXCHANGE_SANDBOX=false